{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "TypeScript config for NestJS apps. Extends base and adds NestJS-specific options.",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "ignoreDeprecations": "5.0"
  }
}
