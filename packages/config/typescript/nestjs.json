{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "TypeScript config for NestJS apps. Extends base and adds NestJS-specific options.",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": false,
    "ignoreDeprecations": "5.0"
  }
}
