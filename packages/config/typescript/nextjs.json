{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "TypeScript config for Next.js apps. Extends base and adds browser/JSX/Next.js-specific options.",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx"
  }
}
