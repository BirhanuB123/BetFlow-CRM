# ==============================================================================
# BETFLOW CRM - ROOT MONOREPO ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in the root directory for local monorepo development.
# ==============================================================================

# ------------------------------------------------------------------------------
# API Service Configuration (apps/api)
# ------------------------------------------------------------------------------

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://betflow:betflowpassword@localhost:5432/betflow_db?schema=public"

# The HTTP Port the NestJS API server listens on (default: 4000)
PORT=4000

# Secret key used for signing & verifying JWT authentication tokens.
# IMPORTANT: Use a high-entropy 64+ character random string in production!
JWT_SECRET="super-secret-betflow-jwt-key4345"

# Node Environment ('development', 'production', 'test')
NODE_ENV="development"

# Path for contract/document storage (PDF generations & attachments)
DOCUMENTS_STORAGE_PATH="./uploads/documents"

# ------------------------------------------------------------------------------
# Third-Party Integrations (Ethiopia SMS Aggregators & Meta Lead Ads)
# ------------------------------------------------------------------------------

# AfroMessage SMS Gateway API Key (Primary Ethiopian SMS Provider)
# AFROMESSAGE_API_KEY="your_afromessage_api_token"
# AFROMESSAGE_SENDER_ID="BetFlow"

# Ethio Telecom Enterprise Direct SMS Gateway (Fallback Provider)
# ETHIO_SMS_API_URL="https://sms.ethiotelecom.et/api/v1/send"
# ETHIO_SMS_TOKEN="your_ethio_telecom_bearer_token"
# ETHIO_SMS_SHORTCODE="8844"

# Meta (Facebook & Instagram) Lead Ads Webhook Verification & App Secret
# META_VERIFY_TOKEN="betflow_meta_lead_ad_verify_token_2026"
# META_APP_SECRET="your_meta_app_secret_hash"

# ------------------------------------------------------------------------------
# Web Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------

# Base URL for frontend client-side API HTTP calls
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Public application domain URL (used for web portal links & CORS)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
