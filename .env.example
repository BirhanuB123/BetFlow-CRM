# ==========================================
# BETFLOW CRM - ENVIRONMENT CONFIGURATION
# ==========================================

# --------------------------
# API (NestJS Backend)
# --------------------------
# Database connection string
DATABASE_URL="postgresql://betflow:betflowpassword@localhost:5432/betflow_db?schema=public"

# The port the API runs on (default 4000)
PORT=4000

# Secret for JWT authentication (Use a strong random string in production)
JWT_SECRET="super-secret-betflow-jwt-key"

# --------------------------
# WEB (Next.js Frontend)
# --------------------------
# The URL where the frontend expects to reach the backend API
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# (Optional) Domain configuration for deployment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
