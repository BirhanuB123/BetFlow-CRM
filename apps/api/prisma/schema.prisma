generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------
// Core & Access Control
// --------------------------------------
model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  roles         Role[]
  userRoles     UserRole[]
  rolePermissions RolePermission[]
  permissions   Permission[]
  branches      Branch[]
  projects      Project[]
  buildings     Building[]
  floors        Floor[]
  units         Unit[]
  leadSources   LeadSource[]
  leads         Lead[]
  accounts      Account[]
  customers     Customer[]
  dealStages    DealStage[]
  deals         Deal[]
  siteVisits    SiteVisit[]
  reservations  Reservation[]
  contracts     Contract[]
  payments      Payment[]
  paymentSchedules PaymentSchedule[]
  documents     Document[]
  tasks         Task[]
  notes         Note[]
  activities    Activity[]
  campaigns     Campaign[]
  notifications Notification[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String   @unique
  password  String
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles          UserRole[]
  tasks          Task[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  ownedLeads     Lead[]         @relation("LeadOwner")
  ownedAccounts  Account[]      @relation("AccountOwner")
  notes          Note[]
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String
  module      String
  description String?

  roles RolePermission[]

  @@unique([tenantId, name])
}

model UserRole {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// --------------------------------------
// Organization Structure & Inventory
// --------------------------------------
model Branch {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  location String?
}

model Project {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  status      String  @default("ACTIVE")

  buildings Building[]
}

model Building {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  name        String
  floorsCount Int     @default(1)

  floors Floor[]
}

model Floor {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id])
  floorNumber Int
  name        String?

  units Unit[]
}

model Unit {
  id         String  @id @default(uuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  floorId    String
  floor      Floor   @relation(fields: [floorId], references: [id])
  unitNumber String
  type       String // e.g., APARTMENT, OFFICE, SHOP
  status     String  @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  price      Decimal @db.Decimal(10, 2)
  area       Float?

  deals        Deal[]
  reservations Reservation[]
  contracts    Contract[]
}

// --------------------------------------
// CRM (Sales & Marketing)
// --------------------------------------
model LeadSource {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String // e.g., Facebook, Referral, Website

  leads Lead[]
}

model Lead {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  firstName String
  lastName  String
  company   String?
  email     String?
  phone     String?
  status    String      @default("NEW")
  sourceId  String?
  source    LeadSource? @relation(fields: [sourceId], references: [id])
  ownerId   String?
  owner     User?       @relation("LeadOwner", fields: [ownerId], references: [id])
  createdAt DateTime    @default(now())

  siteVisits SiteVisit[]
}

// Zoho-style company/organization accounts
model Account {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  accountType    String? // CUSTOMER, INVESTOR, PARTNER, DEVELOPER, SUPPLIER, OTHER
  industry       String?
  rating         String? // HOT, WARM, COLD
  phone          String?
  email          String?
  website        String?
  billingStreet  String?
  billingCity    String?
  billingState   String?
  billingCountry String?
  billingZip     String?
  shippingStreet String?
  shippingCity   String?
  shippingState  String?
  shippingCountry String?
  shippingZip    String?
  annualRevenue  Decimal? @db.Decimal(18, 2)
  employees      Int?
  description    String?
  parentAccountId String?
  parentAccount  Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts  Account[] @relation("AccountHierarchy")
  ownerId        String?
  owner          User?     @relation("AccountOwner", fields: [ownerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customers Customer[]
  deals     Deal[]

  @@index([tenantId, name])
  @@index([tenantId, accountType])
  @@index([tenantId, ownerId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String? // job title on the account (Zoho Contact field)
  createdAt DateTime @default(now())

  deals        Deal[]
  siteVisits   SiteVisit[]
  reservations Reservation[]
  contracts    Contract[]

  @@index([tenantId, accountId])
}

model DealStage {
  id          String @id @default(uuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  name        String
  order       Int
  probability Int    @default(0)

  deals Deal[]
}

model Deal {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  value      Decimal   @db.Decimal(10, 2)
  stageId    String
  stage      DealStage @relation(fields: [stageId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  accountId  String?
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id])
  createdAt  DateTime  @default(now())

  contracts Contract[]

  @@index([tenantId, accountId])
}

// --------------------------------------
// Operations & Transactions
// --------------------------------------
model SiteVisit {
  id       String   @id @default(uuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  date     DateTime
  status   String   @default("SCHEDULED")
  notes    String?

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
}

model Reservation {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  status     String   @default("PENDING")
  date       DateTime @default(now())

  payments Payment[]
}

model Contract {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id])
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id])
  startDate  DateTime
  endDate    DateTime?
  totalAmt   Decimal   @db.Decimal(10, 2)
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())

  payments  Payment[]
  schedules PaymentSchedule[]
}

model Payment {
  id       String   @id @default(uuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  amount   Decimal  @db.Decimal(10, 2)
  date     DateTime @default(now())
  method   String // e.g., CASH, CARD, TRANSFER
  status   String   @default("COMPLETED")
  createdAt DateTime @default(now())

  contractId    String?
  contract      Contract?    @relation(fields: [contractId], references: [id])
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
}

model PaymentSchedule {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  dueDate    DateTime
  amount     Decimal  @db.Decimal(10, 2)
  status     String   @default("PENDING") // PENDING, PAID, LATE
}

// --------------------------------------
// Miscellaneous (Tasks, Logs, etc.)
// --------------------------------------
model Document {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  fileUrl    String
  // Using generic relations for polymorphic behavior (could link to leads, deals, users)
  entityType String
  entityId   String
  uploadedAt DateTime @default(now())
}

model Task {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("TODO")
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id])

  entityType String?
  entityId   String?
}

model Note {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  content    String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
}

model Activity {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  type        String
  description String
  userId      String
  entityType  String
  entityId    String
  date        DateTime @default(now())
}

model Campaign {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  type      String
  status    String    @default("DRAFT")
  startDate DateTime?
  endDate   DateTime?
  budget    Decimal?  @db.Decimal(10, 2)
  cost      Decimal?  @db.Decimal(10, 2)
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())
}

model Subscription {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  planName  String
  startDate DateTime
  endDate   DateTime?
  status    String    @default("ACTIVE")
}
