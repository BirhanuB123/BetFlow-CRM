generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------
// Core & Access Control
// --------------------------------------

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  firstName          String
  lastName           String
  avatarUrl          String?
  isActive           Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockoutUntil       DateTime?
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles             UserRole[]
  tasks             Task[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  ownedLeads        Lead[]         @relation("LeadOwner")
  ownedAccounts     Account[]      @relation("AccountOwner")
  notes             Note[]
  uploadedDocuments Document[]     @relation("DocumentUploader")
  reviewedDocuments Document[]     @relation("DocumentReviewer")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  name        String
  module      String
  description String?

  roles RolePermission[]

  @@unique([name])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// --------------------------------------
// Organization Structure & Inventory
// --------------------------------------
model Branch {
  id       String  @id @default(uuid())
  name     String
  location String?
}

model Project {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  category           String   @default("RESIDENTIAL_TOWER") // RESIDENTIAL_TOWER, LUXURY_VILLA_COMPOUND, COMMERCIAL_PLAZA, MIXED_USE_DEVELOPMENT, TOWN_HOUSES
  location           String?  // e.g. Bole Medhanialem, Kazanchis, CMC
  subCity            String?  // BOLE, KIRKOS, NIFAS_SILK_LAFTO, YEKA, ARADA, GULLELE
  constructionStage  String   @default("STRUCTURE_CONCRETE_SLAB") // EXCAVATION_FOUNDATION, STRUCTURE_CONCRETE_SLAB, BRICKWORK_PLASTERING, FINISHING_TILING, HANDOVER_READY
  progressPercentage Int      @default(50)
  estimatedDelivery  String?  // e.g. Q4 2027
  coverImage         String?  // Image URL / path
  gallery            String[] // Rendering & progress photo URLs
  videoUrl           String?  // Telegram / YouTube walkthrough video link
  amenities          String[] // Backup Generator, Elevator, Underground Parking, Water Reservoir, CCTV
  totalAreaSqm       Float?
  avgPricePerSqm     Decimal? @db.Decimal(10, 2)
  status             String   @default("ACTIVE") // PLANNING, ACTIVE, SELLING, COMPLETED, ON_HOLD

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  buildings Building[]
}

model Building {
  id          String  @id @default(uuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  name        String
  floorsCount Int     @default(1)

  floors Floor[]
}

model Floor {
  id          String   @id @default(uuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id])
  floorNumber Int
  name        String?

  units Unit[]
}

model Unit {
  id         String  @id @default(uuid())
  floorId    String
  floor      Floor   @relation(fields: [floorId], references: [id])
  unitNumber String
  type       String // e.g., APARTMENT, OFFICE, SHOP
  status     String  @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  price      Decimal @db.Decimal(10, 2)
  area       Float?

  deals        Deal[]
  reservations Reservation[]
  contracts    Contract[]

  @@index([status, floorId])
  @@index([status, type])
}

// --------------------------------------
// CRM (Sales & Marketing)
// --------------------------------------
model LeadSource {
  id   String @id @default(uuid())
  name String // e.g., Facebook, Referral, Website

  leads Lead[]
}

model Lead {
  id        String      @id @default(uuid())
  firstName String
  lastName  String
  company   String?
  email     String?
  phone     String?
  status    String      @default("NEW")
  sourceId  String?
  source    LeadSource? @relation(fields: [sourceId], references: [id])
  ownerId   String?
  owner     User?       @relation("LeadOwner", fields: [ownerId], references: [id])
  createdAt DateTime    @default(now())

  // Zoho-style conversion: links the lead to the contact it became.
  convertedAt         DateTime?
  convertedCustomerId String?

  siteVisits SiteVisit[]
  meetings   Meeting[]
  callLogs   CallLog[]

  @@index([status, ownerId])
  @@index([convertedAt])
  @@index([email, phone])
}

// Zoho-style company/organization accounts
model Account {
  id              String    @id @default(uuid())
  name            String
  accountType     String? // CUSTOMER, INVESTOR, PARTNER, DEVELOPER, SUPPLIER, OTHER
  industry        String?
  rating          String? // HOT, WARM, COLD
  phone           String?
  email           String?
  website         String?
  billingStreet   String?
  billingCity     String?
  billingState    String?
  billingCountry  String?
  billingZip      String?
  shippingStreet  String?
  shippingCity    String?
  shippingState   String?
  shippingCountry String?
  shippingZip     String?
  annualRevenue   Decimal?  @db.Decimal(18, 2)
  employees       Int?
  description     String?
  parentAccountId String?
  parentAccount   Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts   Account[] @relation("AccountHierarchy")
  ownerId         String?
  owner           User?     @relation("AccountOwner", fields: [ownerId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customers Customer[]
  deals     Deal[]

  @@index([name])
  @@index([accountType])
  @@index([ownerId])
}

model Customer {
  id        String   @id @default(uuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String? // job title on the account (Zoho Contact field)
  createdAt DateTime @default(now())

  deals        Deal[]
  siteVisits   SiteVisit[]
  meetings     Meeting[]
  callLogs     CallLog[]
  reservations Reservation[]
  contracts    Contract[]

  @@index([accountId])
}

model DealStage {
  id          String @id @default(uuid())
  name        String
  order       Int
  probability Int    @default(0)

  deals Deal[]
}

model Deal {
  id         String    @id @default(uuid())
  name       String
  value      Decimal   @db.Decimal(10, 2)
  stageId    String
  stage      DealStage @relation(fields: [stageId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  accountId  String?
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id])
  createdAt  DateTime  @default(now())

  contracts Contract[]

  @@index([accountId])
}

// --------------------------------------
// Operations & Transactions
// --------------------------------------
model SiteVisit {
  id     String   @id @default(uuid())
  date   DateTime
  status String   @default("SCHEDULED")
  notes  String?

  // Ethiopian Real Estate Buyer Preferences & Demands
  preferredSqm    Decimal? @db.Decimal(10, 2)
  bedroomCount    Int?
  preferredFloor  String?
  facingDirection String?
  propertyType    String?
  purpose         String?
  budgetETB       Decimal? @db.Decimal(14, 2)
  paymentMethod   String?
  demands         String?

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([status, date])
  @@index([leadId, customerId])
}

model Meeting {
  id              String   @id @default(uuid())
  title           String
  meetingType     String   @default("IN_PERSON_OFFICE") // IN_PERSON_OFFICE, VIRTUAL_ZOOM, PHONE_CALL
  date            DateTime
  durationMinutes Int      @default(30)
  location        String?
  agenda          String?
  notes           String?
  status          String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CallLog {
  id              String    @id @default(uuid())
  subject         String
  callType        String    @default("OUTBOUND") // OUTBOUND, INBOUND, TELEGRAM, WHATSAPP
  callPurpose     String    @default("POST_VISIT_FOLLOWUP") // POST_VISIT_FOLLOWUP, PAYMENT_REMINDER, DIASPORA_OUTREACH, PROPOSAL_REVIEW, GENERAL_INQUIRY
  callResult      String?   // INTERESTED, REQUESTED_PROFORMA, BUSY_CALL_BACK, NOT_INTERESTED, NO_ANSWER, SCHEDULED_SITE_VISIT
  dueDate         DateTime
  completedAt     DateTime?
  durationSeconds Int?
  notes           String?
  status          String    @default("PENDING") // PENDING, COMPLETED, OVERDUE, SKIPPED

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id                String    @id @default(uuid())
  reservationNumber String?
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  unitId            String
  unit              Unit      @relation(fields: [unitId], references: [id])
  amount            Decimal   @db.Decimal(14, 2)
  holdPeriodDays    Int       @default(14)
  expiryDate        DateTime?
  paymentMethod     String?   // BANK_TRANSFER, TELEBIRR, CBE_BIRR, CASH_DEPOSIT, CHECK
  receiptNumber     String?
  status            String    @default("PENDING") // PENDING, APPROVED, CONVERTED_TO_CONTRACT, CANCELLED, EXPIRED
  date              DateTime  @default(now())
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  payments Payment[]

  @@index([status, expiryDate])
  @@index([customerId, unitId])
}

model Contract {
  id             String    @id @default(uuid())
  contractNumber String?
  contractType   String    @default("SALES_AGREEMENT") // SALES_AGREEMENT, RESERVATION_AGREEMENT, COMMERCIAL_LEASE
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  unitId         String
  unit           Unit      @relation(fields: [unitId], references: [id])
  dealId         String?
  deal           Deal?     @relation(fields: [dealId], references: [id])
  startDate      DateTime
  endDate        DateTime?
  totalAmt       Decimal   @db.Decimal(14, 2)
  downPaymentAmt Decimal?  @db.Decimal(14, 2)
  paymentPlan    String?   // INSTALLMENTS_24M, BANK_MORTGAGE_3070, FULL_CASH, DIASPORA_USD
  status         String    @default("ACTIVE") // ACTIVE, PENDING_SIGNATURE, SIGNED, CANCELLED
  notes              String?
  gracePeriodDays    Int?
  penaltyRatePercent Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  payments   Payment[]
  schedules  PaymentSchedule[]
  signatures SignatureAudit[]

  @@index([status, unitId])
  @@index([customerId, dealId])
}

model Payment {
  id            String    @id @default(uuid())
  amount        Decimal   @db.Decimal(14, 2)
  date          DateTime  @default(now())
  method        String    @default("CBE_BANK_TRANSFER") // CBE_BANK_TRANSFER, TELEBIRR, CBE_BIRR, CASH_DEPOSIT, CHECK
  receiptNumber String?
  status        String    @default("COMPLETED")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  contractId    String?
  contract      Contract?        @relation(fields: [contractId], references: [id])
  reservationId String?
  reservation   Reservation?     @relation(fields: [reservationId], references: [id])
  scheduleId    String?
  schedule      PaymentSchedule? @relation(fields: [scheduleId], references: [id])

  @@index([contractId, status, date])
  @@index([scheduleId])
}

model PaymentSchedule {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id])
  milestoneName String   @default("DOWNPAYMENT_30") // DOWNPAYMENT_30, FOUNDATION_SLAB_20, STRUCTURE_SLAB_20, FINISHING_TILE_20, HANDOVER_KEYS_10
  percentage    Float    @default(30.0)
  dueDate       DateTime
  amount        Decimal  @db.Decimal(14, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(14, 2)
  status             String   @default("PENDING") // PENDING, PAID, PARTIALLY_PAID, OVERDUE
  notes              String?
  isCustomMilestone  Boolean?
  penaltyAmount      Decimal? @db.Decimal(14, 2)
  createdAt          DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  payments Payment[]

  @@index([contractId, status])
}

// --------------------------------------
// Miscellaneous (Tasks, Logs, etc.)
// --------------------------------------
model Document {
  id              String    @id @default(uuid())
  name            String
  fileUrl         String
  storageKey      String?
  mimeType        String?
  sizeBytes       Int?
  checksum        String?
  category        String    @default("OTHER")
  status          String    @default("PENDING_REVIEW")
  // Generic relations let documents be attached to customers, deals, contracts, payments, and inventory.
  entityType      String
  entityId        String
  uploadedById    String?
  uploadedBy      User?     @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      User?     @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime?
  uploadedAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([status])
  @@index([category])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE
  priority    String    @default("MEDIUM") // HIGH, MEDIUM, LOW
  category    String    @default("CLIENT_FOLLOWUP") // PROPOSAL_PREPARATION, SITE_VISIT_PREP, BANK_MORTGAGE_DOCS, CONTRACT_DRAFTING, PAYMENT_COLLECTION, CLIENT_FOLLOWUP
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id])

  entityType String?
  entityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([assigneeId, status, dueDate])
  @@index([entityType, entityId])
}

model Note {
  id         String   @id @default(uuid())
  content    String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Activity {
  id          String   @id @default(uuid())
  type        String
  description String
  userId      String
  entityType  String
  entityId    String
  date        DateTime @default(now())

  @@index([entityType, entityId])
}

model Campaign {
  id        String    @id @default(uuid())
  name      String
  type      String
  status    String    @default("DRAFT")
  startDate DateTime?
  endDate   DateTime?
  budget    Decimal?  @db.Decimal(10, 2)
  cost      Decimal?  @db.Decimal(10, 2)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model SignatureAudit {
  id               String   @id @default(uuid())
  contractId       String
  contract         Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signerName       String
  signerEmail      String?
  signerRole       String   @default("BUYER") // BUYER, SELLER_REP, WITNESS
  signatureDataUrl String   @db.Text
  ipAddress        String   @default("127.0.0.1")
  userAgent        String   @default("Unknown")
  verificationHash String
  signedAt         DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([contractId])
}

